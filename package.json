{
  "name": "subscriber-usage-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for recording and retrieving subscriber usage, with scheduled snapshot automation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "snapshot:once": "tsx scripts/snapshot.ts --once",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}